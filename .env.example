# 公交换乘票价清分服务 —— 应用配置
# 所有配置均可通过同名环境变量覆盖

# PostgreSQL DSN（Compose 中指向 db 服务）
DATABASE_URL=postgresql://fare:farepass@db:5432/fareclearing

# HTTP 服务监听地址与端口
APP_HOST=0.0.0.0
APP_PORT=8080

# 运营日界：每天 04:00 之前的乘车计入上一运营日
DAY_BOUNDARY_HOUR=4

# 相邻两程最大间隔（分钟），不超过该值归为同一换乘组
TRANSFER_WINDOW_MINUTES=90

# 账户单个运营日实收封顶金额（分）
DAILY_CAP_CENTS=2000
